    "import os\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "from matplotlib.ticker import MultipleLocator\n",
    "from IPython.display import Image, display\n",
    "\n",
    "def compare_loss_curves(models, labels, losses=['total loss'], path=\"\", yscales=['linear'], interval=10):\n",
    "\n",
    "    ### Check if save directory exists\n",
    "    os.makedirs(os.path.join(experiement_pth, path), exist_ok=True)\n",
    "\n",
    "    \n",
    "    # Plot each loss\n",
    "    for i, loss in enumerate(losses):\n",
    "        plt.close()\n",
    "        plt.title(loss)\n",
    "        for j, mdl in enumerate(models):\n",
    "            df = pd.read_csv(os.path.join(mdl, 'losses.csv'))\n",
    "            plt.plot(df[loss][::interval], label=labels[j])\n",
    "        plt.yscale(yscales[i])\n",
    "        plt.legend()\n",
    "        plt.savefig(os.path.join(experiement_pth, path, loss + '.png'))\n",
    "        plt.show()\n",
    "\n",
    "def get_success_rate_and_steps(path):\n",
    "    df = pd.read_csv(path)\n",
    "\n",
    "    successes = df['evaluation/success'].to_list()\n",
    "    successes = [n.strip(\"[]\").split(\", \") for n in successes]\n",
    "    successes = [[1 if mm == 'True' else 0 for mm in n] for n in successes]\n",
    "    # successes = np.asarray(successes)\n",
    "\n",
    "    eps = len(successes)\n",
    "    ## reduce the succeess to 1 if any of the episode is success\n",
    "    success_eps = []\n",
    "    for i in range(eps):\n",
    "        success_eps.append(np.any(successes[i]))\n",
    "\n",
    "    # get the success rate\n",
    "    rate = np.sum(success_eps) / len(success_eps)\n",
    "\n",
    "    ## get steps-to-success if an episode is success\n",
    "    steps_to_success = []\n",
    "    for i in range(eps):\n",
    "        if success_eps[i]:\n",
    "            steps_to_success.append(np.argmax(successes[i])+1)\n",
    "        else:\n",
    "            steps_to_success.append(30)\n",
    "    \n",
    "    # np.argmax(successes, axis=1)\n",
    "\n",
    "    # filter out the episode that is not success\n",
    "    # steps_to_success = np.asarray(steps_to_success)\n",
    "    # steps_to_success = steps_to_success[success_eps]\n",
    "\n",
    "    return rate, steps_to_success, eps\n",
    "\n",
    "def get_metrics(path, step=30, success_criteria=0):\n",
    "    df = pd.read_csv(path)\n",
    "\n",
    "    if success_criteria == 0:\n",
    "        success_fn = lambda x, y: x > 0.90 and y > 0.80\n",
    "    elif success_criteria == 1:\n",
    "        success_fn = lambda x, y: x > 0.90\n",
    "\n",
    "\n",
    "    NC = df['evaluation/normalised_coverage'].to_list()\n",
    "    NC = [n.strip(\"[]\").split(\", \") for n in NC]\n",
    "    NC = [[float(mm) for mm in n] for n in NC]\n",
    "    NC = np.asarray(NC)\n",
    "    ret_NC = []\n",
    "    NI = df['evaluation/normalised_improvement'].to_list()\n",
    "    NI = [n.strip(\"[]\").split(\", \") for n in NI]\n",
    "    NI = [[float(mm) for mm in n] for n in NI]\n",
    "    ret_NI = []\n",
    "\n",
    "    IoU = df['evaluation/max_IoU'].to_list()\n",
    "    IoU = [n.strip(\"[]\").split(\", \") for n in IoU]\n",
    "    IoU = [[float(mm) for mm in n] for n in IoU]\n",
    "    ret_IoU = []\n",
    "\n",
    "    HD = df['evaluation/normalised_hausdorff_distance'].to_list()\n",
    "    HD = [n.strip(\"[]\").split(\", \") for n in HD]\n",
    "    HD = [[float(mm) for mm in n] for n in HD]\n",
    "    ret_HD = []\n",
    "    step2success = []\n",
    "\n",
    "    for i in range(len(NC)):\n",
    "        ret_NC.append(NC[i][-1])\n",
    "        ret_NI.append(NI[i][-1])\n",
    "        ret_IoU.append(IoU[i][-1])\n",
    "        ret_HD.append(HD[i][-1])\n",
    "        step2success.append(len(NC[i])-1)\n",
    "        for j in range(len(NC[i])):\n",
    "            if success_fn(NC[i][j], IoU[i][j]):\n",
    "                ret_NC[-1] = NC[i][j]\n",
    "                ret_NI[-1] = NI[i][j]\n",
    "                ret_IoU[-1] = IoU[i][j]\n",
    "                ret_HD[-1] = HD[i][j]\n",
    "                step2success[-1] = j\n",
    "                break\n",
    "    \n",
    "    total_eps = len(NC)\n",
    "    success_eps = 0\n",
    "    # get SR, for each episode, NC should be larger than 0.99 and IoU should be larger than 0.85\n",
    "\n",
    "    for i in range(total_eps):\n",
    "        if success_fn(ret_NC[i], ret_IoU[i]):\n",
    "            success_eps += 1\n",
    "\n",
    "\n",
    "\n",
    "    return ret_NC, ret_NI, ret_IoU, ret_HD, len(NC), success_eps, step2success"
   ]
  },
